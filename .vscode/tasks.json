{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Backend (FastAPI)",
      "type": "shell",
      "command": "backend\\venv\\Scripts\\python.exe -m uvicorn main:app --app-dir backend --host 127.0.0.1 --port 8000 --reload",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Start Frontend (Next.js)",
      "type": "shell",
      "command": "cmd.exe /c \"cd frontend && npm run dev\"",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Run Entire Project",
      "dependsOn": [
        "Start Backend (FastAPI)",
        "Start Frontend (Next.js)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
